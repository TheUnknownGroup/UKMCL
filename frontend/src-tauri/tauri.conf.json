{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ukmcl",
  "version": "2.0.0",
  "identifier": "ukmcl",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173/",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
        "withGlobalTauri": true,
        "windows": [
          {
            "title": "UKMCL",
            "width": 1080,
            "height": 600,
            "center": true,
            "minWidth": 1080,
            "minHeight": 600,
            "resizable": true,
            "decorations": false,
            "transparent": true
          }
        ],
        "security": {
          "csp": "default-src 'self'; img-src 'self' https: data: blob: asset: https://asset.localhost; font-src 'self' https://asset.localhost; style-src 'self' 'unsafe-inline'"
        }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "devonk15",
    "homepage": "https://github.com/TheUnknownGrouo/UKMCL",
    "category": "Game",
    "license": "MIT",
    "shortDescription": "The Official UKMCL App",
    "longDescription": "UKMCL runs and install Minecraft and gives user's the ability to create instances, download modpacks, and soon to be more!",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}